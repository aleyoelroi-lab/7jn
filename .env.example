# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Formspree endpoint custom integration (e.g., https://formspree.io/f/xbjny...)
# If not provided, forms will fall back to localized success states.
VITE_FORMSPREE_ENDPOINT=

# Custom Payment QR Code URL (e.g., /qr-code.png or direct image link)
# Leave blank to use the generic high-tech QR code generator
VITE_PAYMENT_QR_CODE_URL=

# Custom Profile / Headshot Image URL (e.g., an uploaded image link or local path like /profile.png)
# Leave blank to fall back to the default profile and placeholder assets
VITE_PROFILE_IMAGE_URL=
